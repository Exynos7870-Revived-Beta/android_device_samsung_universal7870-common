cc_defaults {
    name: "libcamera_metadata_helper_defaults",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "CameraMetadata.cpp",
        "CameraParameters.cpp",
    ],
    cflags: [
        "-Werror",
        "-Wextra",
        "-Wall",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libhardware",
        "libcamera_metadata",
    ],
    include_dirs: ["system/media/private/camera/include"],
}

cc_library_shared {
    name: "libcamera_metadata_helper",
    defaults: ["libcamera_metadata_helper_defaults"],
}

cc_library_shared {
    name: "libcamera_client.vendor",
    stem: "libcamera_client",
    defaults: ["libcamera_metadata_helper_defaults"],
}
